{
    "version": "9.9.0",
    "description": "An open-source build automation tool focused on flexibility and performance. (Source code and documentation bundled)",
    "homepage": "https://gradle.org",
    "license": "Apache-2.0",
    "suggest": {
        "JDK": "java/openjdk"
    },
    "url": "https://mirrors.cloud.tencent.com/gradle/gradle-9.9.0-all.zip",
    "hash": "7aaba33a6aa7d03e0c7890869da1f1b5e1765c4d71db981a9d5db5cc47a10a6d",
    "extract_dir": "gradle-9.9.0",
    "post_install": [
        "$current_env = Get-EnvVar -Name GRADLE_USER_HOME -Global:$global",
        "If ($null -eq $current_env) {",
        "    $path = \"$dir\\.gradle\"",
        "    Set-EnvVar -Name GRADLE_USER_HOME -Value $path -Global:$global",
        "    $Env:GRADLE_USER_HOME = $path",
        "    Write-Host \"Environment variable 'GRADLE_USER_HOME' set to '$path'\"",
        "}"
    ],
    "persist": ".gradle",
    "bin": "bin\\gradle.bat",
    "checkver": {
        "url": "https://gradle.org/releases/",
        "regex": ">([\\d.]+)</a"
    },
    "autoupdate": {
        "url": "https://mirrors.cloud.tencent.com/gradle/gradle-$version-all.zip",
        "hash": {
            "url": "https://services.gradle.org/distributions/gradle-$version-all.zip.sha256"
        },
        "extract_dir": "gradle-$version"
    }
}
